# ---- tailnet ---------------------------------------------------------------
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
# `tailscale ip -4` of each site (Tailscale admin console > Machines)
LOCAL_TS_IP=100.64.0.1
CLOUD_TS_IP=100.64.0.2

# ---- shared secrets (identical to the local site) --------------------------
SPILLWAY_TOKEN=change-me-long-random-token
REPL_PASSWORD=change-me-replication
APP_DB_PASSWORD=change-me-app

# ---- images (pushed by scripts/push-images.sh) ------------------------------
SPILLWAY_IMAGE=asia-northeast3-docker.pkg.dev/PROJECT/spillway/spillway:latest
SPILLWAY_PG_IMAGE=asia-northeast3-docker.pkg.dev/PROJECT/spillway/spillway-pg:latest

# URL shown on the dashboard (terraform output public_url)
PUBLIC_URL=http://203.0.113.10

# ---- burst providers: cloudrun, ecs or "cloudrun,ecs" -----------------------
CLOUD_PROVIDERS=cloudrun
# Keep N cloud instances warm (0 traffic) to cut evacuation time; costs money.
CLOUD_WARM_MIN=0
BURST_MIN=2
BURST_MAX=6
EVAC_MIN=2
LOCAL_UNITS=1

# GCP (terraform output)
GCP_PROJECT=my-project
GCP_REGION=asia-northeast3
CLOUDRUN_SERVICE=spillway-app

# AWS (terraform output in deploy/aws), only when CLOUD_PROVIDERS includes ecs
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ECS_CLUSTER=spillway
ECS_SERVICE=spillway-app
ECS_ENDPOINT_URL=http://spillway-alb-123.ap-northeast-2.elb.amazonaws.com
