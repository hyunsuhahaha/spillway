# Tailscale auth key (Settings > Keys). A reusable key is easiest for demos.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Must be identical on the local site and the cloud anchor VM.
SPILLWAY_TOKEN=change-me-long-random-token
REPL_PASSWORD=change-me-replication
APP_DB_PASSWORD=change-me-app

# Demo capacity of the local server (3 concurrent requests x 25 ms work each
# ~= 120 rps). Bursting starts when this is exceeded.
WORK_MS=25
LOCAL_MAX_INFLIGHT=3
LOCAL_INSTANCE_NAME=laptop
